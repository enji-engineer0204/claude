# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# Required: the sessionid cookie copied from the consenting account's
# logged-in Chrome (DevTools -> Application -> Cookies -> instagram.com).
INSTAGRAM_SESSIONID=

# Required (unless NOTIFIER_TYPE=none): Discord or Slack incoming webhook URL.
WEBHOOK_URL=

# Optional: account to track. Empty = the logged-in account itself.
TARGET_USERNAME=

# Optional: discord | slack | none   (default: discord)
NOTIFIER_TYPE=discord

# Optional: check interval, e.g. 12h, 24h, 6h. (default: 12h)
INTERVAL=12h
